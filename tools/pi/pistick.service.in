[Unit]
Description=PiStick (psd)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
User=@USUARIO@
SupplementaryGroups=video render
EnvironmentFile=/etc/pistick/psd.conf
RuntimeDirectory=pistick
Environment=XDG_RUNTIME_DIR=/run/pistick
Environment=SHELL=@SHELL@
StateDirectory=pistick
StateDirectoryMode=0700
WorkingDirectory=@CASA@
ExecStart=/usr/local/libexec/pistick/iniciar-servico.sh
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
LimitRTPRIO=20
LimitNICE=-11
ExecStopPost=-+/usr/local/libexec/pistick/parar-android.sh

ProtectSystem=strict
ReadWritePaths=@CASA@
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=@system-service
SystemCallFilter=mincore
DevicePolicy=closed
DeviceAllow=/dev/null rw
DeviceAllow=/dev/zero rw
DeviceAllow=/dev/full rw
DeviceAllow=/dev/random r
DeviceAllow=/dev/urandom r
DeviceAllow=/dev/video11 rw
DeviceAllow=/dev/dri/renderD128 rw
DeviceAllow=char-binder rw
UMask=0077

[Install]
WantedBy=multi-user.target
